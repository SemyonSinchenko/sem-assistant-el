Listen 6065

DavLockDB /tmp/DavLock

<VirtualHost *:6065>
  ServerName @@WEBDAV_DOMAIN@@
  SSLEngine on
  SSLCertificateFile @@WEBDAV_CERT_FILE@@
  SSLCertificateKeyFile @@WEBDAV_KEY_FILE@@

  # Only the tasks/settings subtree is served; notes, journal and digests
  # live in /data/org-roam and are not reachable from WebDAV clients.
  DocumentRoot "/data/tasks"

  # DAV is enabled on the data directory only, so aliased paths such as /ui
  # are plain static files (mod_dav cannot switch off a subtree of a
  # DAV-enabled <Location>).
  <Directory "/data/tasks">
    Dav On
    Options Indexes FollowSymLinks
    AllowOverride None
    Require all granted
  </Directory>

  <Location "/">
    Header always set Vary "Origin" "expr=-n %{req:Origin}"
    Header always set Access-Control-Allow-Origin "@@ORGANICE_ORIGIN@@" "expr=%{req:Origin} == '@@ORGANICE_ORIGIN@@'"
    Header always set Access-Control-Allow-Credentials "true" "expr=%{req:Origin} == '@@ORGANICE_ORIGIN@@'"
    Header always set Access-Control-Allow-Methods "OPTIONS, GET, PROPFIND, PUT, DELETE, MOVE, COPY, MKCOL, PROPPATCH, LOCK, UNLOCK" "expr=%{REQUEST_METHOD} == 'OPTIONS' && %{req:Origin} == '@@ORGANICE_ORIGIN@@'"
    Header always set Access-Control-Allow-Headers "Authorization, Content-Type, Depth, Destination, If, If-Match, If-None-Match, If-Unmodified-Since, Lock-Token, Overwrite, Timeout, X-Requested-With" "expr=%{REQUEST_METHOD} == 'OPTIONS' && %{req:Origin} == '@@ORGANICE_ORIGIN@@'"
    Header always set Access-Control-Max-Age "600" "expr=%{REQUEST_METHOD} == 'OPTIONS' && %{req:Origin} == '@@ORGANICE_ORIGIN@@'"

    AuthType Basic
    AuthName "SEM WebDAV"
    AuthUserFile "/usr/local/apache2/conf/webdav.htpasswd"
    <LimitExcept OPTIONS>
      Require valid-user
    </LimitExcept>
  </Location>

  # org-ui: static SPA served next to WebDAV on the same origin (no CORS).
  # The bundle holds no data, so it is public; the app sends Basic auth
  # itself on every WebDAV request.
  Alias /ui /usr/local/apache2/ui
  <Directory "/usr/local/apache2/ui">
    Options None
    AllowOverride None
    Require all granted
  </Directory>

  <Location "/ui">
    Require all granted
    Header always unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Credentials
  </Location>

  <LocationMatch "^/ui/(index\.html|config\.json)?$">
    Header set Cache-Control "no-cache"
  </LocationMatch>

  <LocationMatch "^/ui/assets/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </LocationMatch>

  ErrorLog /proc/self/fd/2
  CustomLog /proc/self/fd/1 combined
</VirtualHost>

<VirtualHost *:6065>
  ServerName @@ORGANICE_DOMAIN@@
  SSLEngine on
  SSLCertificateFile @@ORGANICE_CERT_FILE@@
  SSLCertificateKeyFile @@ORGANICE_KEY_FILE@@

  ProxyPreserveHost On
  ProxyPass / http://organice:5000/
  ProxyPassReverse / http://organice:5000/

  ErrorLog /proc/self/fd/2
  CustomLog /proc/self/fd/1 combined
</VirtualHost>
