;;; sem-orgnote.el --- orgnote server sync for the org-roam repository -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

;;; Commentary:
;; Synchronizes /data/org-roam with a self-hosted orgnote server through
;; `orgnote-cli', so the graph, notes, journal and digests are available in
;; the orgnote apps.
;;
;; Every cycle (cron, every 5 minutes):
;; 1. git pre-pull of the repository (existing git-sync step);
;; 2. refresh read-only copies of tasks.org / rec-tasks.org under sem/;
;; 3. run `orgnote-cli sync' asynchronously;
;; 4. report new `*.sync-conflict-*' files as TODOs in errors.org.
;;
;; The CLI keeps its sync state under HOME/.config/orgnote, so HOME points at
;; a persistent directory on the data volume.  sem/ and the client's .orgnote/
;; directory are excluded from git through .git/info/exclude: the CLI honours
;; the repository .gitignore, and sem/ must still reach orgnote.
;;
;; Sync is enabled only when ORGNOTE_API_TOKEN is set and orgnote-cli is
;; installed; otherwise the cycle is just the git pre-pull.

;;; Code:

(require 'cl-lib)
(require 'subr-x)
(require 'sem-core)

(defconst sem-orgnote-root "/data/org-roam/"
  "Repository synchronized with orgnote (orgnote-cli rootFolder).")

(defconst sem-orgnote-home "/data/.orgnote-home/"
  "Persistent HOME for orgnote-cli: holds its config and sync state.")

(defconst sem-orgnote-backup-dir "/data/.orgnote-backups/"
  "Directory where orgnote-cli keeps pre-sync backups.")

(defconst sem-orgnote-log-file "/var/log/sem/orgnote-cli.log"
  "Log file written by orgnote-cli.")

(defconst sem-orgnote-copy-dir "/data/org-roam/sem/"
  "Directory of read-only task copies visible in orgnote.")

(defconst sem-orgnote-copy-sources
  '("/data/tasks/tasks.org" "/data/tasks/rec-tasks.org")
  "Task files mirrored read-only into `sem-orgnote-copy-dir'.")

(defconst sem-orgnote-git-excluded '("sem/" ".orgnote/")
  "Paths kept out of git but synced to orgnote.")

(defconst sem-orgnote-account "sem"
  "Account name used in the generated orgnote-cli config.")

(defconst sem-orgnote-timeout-seconds 600
  "Seconds after which a running orgnote-cli sync is killed.")

(defconst sem-orgnote-conflicts-file "/data/.sem-orgnote-conflicts.el"
  "List of conflict files already reported to errors.org.")

(defvar sem-orgnote--process nil
  "The running orgnote-cli process, or nil.")

;;; Configuration

(defun sem-orgnote-token ()
  "Return the orgnote API token from ORGNOTE_API_TOKEN, or nil."
  (let ((token (getenv "ORGNOTE_API_TOKEN")))
    (unless (or (null token) (string-blank-p token))
      (string-trim token))))

(defun sem-orgnote-remote-address ()
  "Return the orgnote API address used by the daemon.
Defaults to the backend container on the compose network, which avoids a
round trip through TLS and the public domain."
  (let ((address (getenv "ORGNOTE_REMOTE_ADDRESS")))
    (if (or (null address) (string-blank-p address))
        "http://orgnote-backend:3000/v1"
      (string-trim address))))

(defun sem-orgnote-enabled-p ()
  "Return non-nil when orgnote sync is configured and orgnote-cli exists."
  (and (sem-orgnote-token) (executable-find "orgnote-cli") t))

(defun sem-orgnote-running-p ()
  "Return non-nil while an orgnote-cli sync is in progress."
  (and sem-orgnote--process (process-live-p sem-orgnote--process)))

(defun sem-orgnote--toml-string (value)
  "Return VALUE as a quoted TOML basic string."
  (format "\"%s\"" (replace-regexp-in-string "[\"\\\\]" "\\\\\\&" value)))

(defun sem-orgnote--config-content (token)
  "Return the orgnote-cli config.toml content for TOKEN."
  (concat
   "# Generated by sem-assistant; rewritten before every sync.\n"
   "[[accounts]]\n"
   "name = " (sem-orgnote--toml-string sem-orgnote-account) "\n"
   "remoteAddress = " (sem-orgnote--toml-string (sem-orgnote-remote-address)) "\n"
   "token = " (sem-orgnote--toml-string token) "\n"
   "rootFolder = " (sem-orgnote--toml-string (directory-file-name sem-orgnote-root)) "\n"
   "logPath = " (sem-orgnote--toml-string sem-orgnote-log-file) "\n"
   "backupDir = " (sem-orgnote--toml-string (directory-file-name sem-orgnote-backup-dir)) "\n"
   "backupCount = 3\n"
   "ignorePatterns = [\"*.tmp\", \"org-roam.db*\"]\n"))

(defun sem-orgnote--write-config (token)
  "Write the orgnote-cli config for TOKEN, readable only by the daemon user."
  (let ((file (expand-file-name ".config/orgnote/config.toml" sem-orgnote-home)))
    (make-directory (file-name-directory file) t)
    (with-temp-file file
      (insert (sem-orgnote--config-content token)))
    (set-file-modes file #o600)
    file))

;;; Git exclusion

(defun sem-orgnote--ensure-git-exclude (repo-dir)
  "Keep `sem-orgnote-git-excluded' out of git in REPO-DIR without .gitignore.
Also removes a `sem/' entry from .gitignore written by an earlier layout
migration, since orgnote-cli would then skip the copies."
  (let ((git-dir (expand-file-name ".git" repo-dir)))
    (when (file-directory-p git-dir)
      (let* ((exclude (expand-file-name "info/exclude" git-dir))
             (content (if (file-exists-p exclude)
                          (with-temp-buffer (insert-file-contents exclude) (buffer-string))
                        ""))
             (missing (cl-remove-if
                       (lambda (entry)
                         (string-match-p (concat "^" (regexp-quote entry) "$") content))
                       sem-orgnote-git-excluded)))
        (when missing
          (make-directory (file-name-directory exclude) t)
          (write-region (concat (if (or (string-empty-p content)
                                        (string-suffix-p "\n" content))
                                    ""
                                  "\n")
                                "# synced to orgnote, not to git (sem-assistant)\n"
                                (mapconcat #'identity missing "\n") "\n")
                        nil exclude t 'silent))))
    (let ((gitignore (expand-file-name ".gitignore" repo-dir)))
      (when (file-exists-p gitignore)
        (let* ((content (with-temp-buffer (insert-file-contents gitignore) (buffer-string)))
               (cleaned (replace-regexp-in-string
                         "^\\(# daemon-managed read-only copies\n\\)?sem/\n?" "" content)))
          (unless (string= content cleaned)
            (write-region cleaned nil gitignore nil 'silent)))))))

;;; Read-only task copies

(defun sem-orgnote--copy-header (source)
  "Return the read-only header for a copy of SOURCE."
  (format (concat "# Read-only copy of %s, refreshed by sem-assistant.\n"
                  "# Edit tasks in Orgzly or organice: changes made here are overwritten.\n\n")
          (file-name-nondirectory source)))

(defun sem-orgnote-refresh-copies ()
  "Mirror `sem-orgnote-copy-sources' into `sem-orgnote-copy-dir'.
A copy is rewritten only when its content would change, so unchanged
tasks do not produce sync traffic.  Returns the number of written copies."
  (let ((written 0))
    (make-directory sem-orgnote-copy-dir t)
    (dolist (source sem-orgnote-copy-sources)
      (when (file-exists-p source)
        (let* ((target (expand-file-name (file-name-nondirectory source) sem-orgnote-copy-dir))
               (content (concat (sem-orgnote--copy-header source)
                                (with-temp-buffer
                                  (insert-file-contents source)
                                  (buffer-string))))
               (current (and (file-exists-p target)
                             (with-temp-buffer
                               (insert-file-contents target)
                               (buffer-string)))))
          (unless (equal content current)
            ;; Write outside the synced tree, then rename into place, so a
            ;; concurrent scan never sees a partial file.
            (let ((tmp (make-temp-file
                        (expand-file-name ".sem-copy-"
                                          (file-name-directory
                                           (directory-file-name sem-orgnote-root))))))
              (write-region content nil tmp nil 'silent)
              (rename-file tmp target t))
            (setq written (1+ written))))))
    written))

;;; Conflict reporting

(defun sem-orgnote--conflict-files ()
  "Return relative paths of orgnote conflict files in the repository."
  (when (file-directory-p sem-orgnote-root)
    (mapcar (lambda (file) (file-relative-name file sem-orgnote-root))
            (cl-remove-if
             (lambda (file) (string-match-p "/\\.git/" file))
             (directory-files-recursively sem-orgnote-root "\\.sync-conflict-")))))

(defun sem-orgnote--read-reported ()
  "Return the list of conflict files already reported."
  (when (file-exists-p sem-orgnote-conflicts-file)
    (ignore-errors
      (with-temp-buffer
        (insert-file-contents sem-orgnote-conflicts-file)
        (read (current-buffer))))))

(defun sem-orgnote-report-conflicts ()
  "Create one errors.org TODO per new orgnote conflict file.
Returns the list of newly reported files."
  (let* ((current (sem-orgnote--conflict-files))
         (reported (sem-orgnote--read-reported))
         (new (cl-set-difference current reported :test #'string=)))
    (dolist (file new)
      (sem-core-log-error "orgnote" "SYNC"
                          (format "Resolve orgnote sync conflict: %s" file)
                          (concat "Both versions were kept. Compare the conflict file with "
                                  "its original in orgnote or Emacs, keep the right content "
                                  "and delete the conflict file.")
                          nil
                          (list :priority "[#B]" :tags '("orgnote"))))
    ;; Forget resolved files so a later conflict with the same name is reported.
    (with-temp-file sem-orgnote-conflicts-file
      (prin1 current (current-buffer)))
    new))

;;; Sync

(defun sem-orgnote--output-failed-p (exit-status output)
  "Return non-nil when an orgnote-cli run failed.
orgnote-cli exits with 0 even after errors, so OUTPUT is checked too.
EXIT-STATUS is the process exit code."
  (or (not (eql exit-status 0))
      (string-match-p "Unexpected error\\|No token provided\\|No rootFolder provided" output)))

(defun sem-orgnote--summary (output)
  "Return the last non-empty line of OUTPUT, shortened for the log."
  (let ((line (car (last (split-string output "\n" t "[ \t\r]+")))))
    (truncate-string-to-width (or line "") 180)))

(defun sem-orgnote-sync (&optional callback)
  "Run one orgnote-cli sync asynchronously.
CALLBACK, when non-nil, is called with non-nil on success.  Returns t when a
sync was started."
  (cond
   ((not (sem-orgnote-enabled-p))
    (when callback (funcall callback nil))
    nil)
   ((sem-orgnote-running-p)
    (sem-core-log "orgnote" "SYNC" "SKIP" "Previous orgnote sync still running")
    (when callback (funcall callback nil))
    nil)
   (t
    (condition-case err
        (let* ((output-buffer (generate-new-buffer " *orgnote-cli*"))
               (timer nil)
               (process-environment
                (cons (concat "HOME=" (directory-file-name sem-orgnote-home))
                      process-environment)))
          (sem-orgnote-refresh-copies)
          (sem-orgnote--ensure-git-exclude sem-orgnote-root)
          (sem-orgnote--write-config (sem-orgnote-token))
          (make-directory sem-orgnote-backup-dir t)
          (setq sem-orgnote--process
                (make-process
                 :name "orgnote-cli"
                 :buffer output-buffer
                 :command (list "orgnote-cli" "sync" "--account" sem-orgnote-account)
                 :connection-type 'pipe
                 :noquery t
                 :sentinel
                 (lambda (process _event)
                   (unless (process-live-p process)
                     (when timer (cancel-timer timer))
                     (let* ((output (if (buffer-live-p output-buffer)
                                        (with-current-buffer output-buffer (buffer-string))
                                      ""))
                            (failed (sem-orgnote--output-failed-p
                                     (process-exit-status process) output)))
                       (when (buffer-live-p output-buffer) (kill-buffer output-buffer))
                       (setq sem-orgnote--process nil)
                       (condition-case cb-err
                           (progn
                             (if failed
                                 (sem-core-log-error "orgnote" "SYNC"
                                                     (format "orgnote sync failed: %s"
                                                             (sem-orgnote--summary output))
                                                     nil nil)
                               (sem-core-log "orgnote" "SYNC" "OK"
                                             (format "orgnote sync done: %s"
                                                     (sem-orgnote--summary output))))
                             (sem-orgnote-report-conflicts)
                             (when callback (funcall callback (not failed))))
                         (error
                          (message "SEM: orgnote sync callback error: %s"
                                   (error-message-string cb-err)))))))))
          (setq timer
                (run-at-time sem-orgnote-timeout-seconds nil
                             (lambda ()
                               (when (sem-orgnote-running-p)
                                 (message "SEM: orgnote sync timed out, killing it")
                                 (delete-process sem-orgnote--process)))))
          t)
      (error
       (setq sem-orgnote--process nil)
       (sem-core-log-error "orgnote" "SYNC"
                           (format "orgnote sync could not start: %s"
                                   (error-message-string err))
                           nil nil)
       (when callback (funcall callback nil))
       nil)))))

;;;###autoload
(defun sem-orgnote-sync-cycle ()
  "Cron entry point: git pre-pull of the repository, then orgnote sync.
Without orgnote configuration this is just the git pre-pull."
  (condition-case err
      (if (sem-orgnote-running-p)
          (sem-core-log "orgnote" "SYNC" "SKIP" "orgnote sync running; cycle skipped")
        (when (fboundp 'sem-git-sync-org-roam-prepull)
          (sem-git-sync-org-roam-prepull))
        (sem-orgnote-sync))
    (error
     (sem-core-log-error "orgnote" "SYNC"
                         (format "Sync cycle error: %s" (error-message-string err))
                         nil nil)
     nil)))

(provide 'sem-orgnote)
;;; sem-orgnote.el ends here
