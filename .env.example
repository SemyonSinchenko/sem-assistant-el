# LLM provider configuration (required)
# LLM_PROVIDER: deepseek (default) or openrouter (legacy).
LLM_PROVIDER=deepseek
# DeepSeek API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Medium tier (URL capture, RSS digest, planning, daily plan).
LLM_MODEL=deepseek-v4-pro
# Weak tier (Pass 1 :task: normalization). Falls back to LLM_MODEL when empty.
LLM_WEAK_MODEL=deepseek-flash
# Thinking per tier: none (disabled, fastest) | low | high | max.
# DeepSeek thinks at "high" by default, which can take minutes; these
# pipelines are bounded transformations, so thinking is off by default.
LLM_REASONING_EFFORT=none
LLM_WEAK_REASONING_EFFORT=none

# Legacy OpenRouter configuration (only used with LLM_PROVIDER=openrouter)
# OPENROUTER_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_WEAK_MODEL=
# Required IANA timezone used for all runtime scheduling semantics.
# Example valid values: Europe/Belgrade, America/New_York, Asia/Tokyo, Etc/UTC
CLIENT_TIMEZONE=

# RSS Digest Configuration (optional, defaults shown)
RSS_MAX_ENTRIES_PER_FEED=10
RSS_MAX_INPUT_CHARS=199000

# Daemon watchdog configuration (optional, defaults shown)
SEM_WATCHDOG_PROBE_TIMEOUT_SEC=45
SEM_WATCHDOG_STARTUP_GRACE_SEC=180

# WebDAV and organice domain configuration (required for production)
# WEBDAV_DOMAIN must match the Let's Encrypt certificate domain for WebDAV.
# ORGANICE_DOMAIN must be a dedicated HTTPS domain used to serve self-hosted organice.
# ORGANICE_ORIGIN must exactly match https://ORGANICE_DOMAIN (no wildcard origins).
# ORGANICE_IMAGE defaults to a pinned upstream release image.
WEBDAV_DOMAIN=example.com
ORGANICE_DOMAIN=organice.example.com
ORGANICE_ORIGIN=https://organice.example.com
ORGANICE_IMAGE=twohundredok/organice:5826
WEBDAV_USERNAME=orgzly
WEBDAV_PASSWORD=ChangeMeStrongPassword2026

# Optional task API retry cap (must be >0). Default is 3 when unset.
SEM_TASK_API_MAX_RETRIES=3

# Certbot Configuration (production only; enable with: docker compose --profile certbot up -d)
# CERTBOT_EMAIL is required by Let's Encrypt for certificate issuance notices
CERTBOT_EMAIL=admin@example.com
# true = Let's Encrypt staging CA (safe for first validation), false = production CA
CERTBOT_STAGING=true
# Interval between renewal checks in the certbot container
CERTBOT_RENEW_INTERVAL=12h

# WebDAV certificate auto-reload interval (seconds).
# The webdav container polls the on-disk TLS certificates for changes and
# gracefully reloads httpd when a renewal is detected. Default 300s; clamped
# to a minimum of 60s.
WEBDAV_CERT_RELOAD_INTERVAL=300
