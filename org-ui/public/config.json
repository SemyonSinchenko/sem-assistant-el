{
  "inbox": {
    "path": "inbox-mobile.org"
  },
  "templates": [
    { "id": "link",    "label": "Link", "tag": "link",    "title": "firstLine", "icon": "link",  "placeholder": "Paste a URL (a comment may follow on the next lines)" },
    { "id": "task",    "label": "Task", "tag": "task",    "title": "firstLine", "icon": "check", "placeholder": "e.g. call the accountant tomorrow !" },
    { "id": "journal", "label": "Journal", "tag": "journal", "title": "timestamp", "icon": "book",  "placeholder": "What happened?" }
  ],
  "todoKeywords": { "active": ["TODO", "NEXT", "WAITING"], "done": ["DONE", "CANCELLED"] },
  "readOnly": ["inbox-mobile.org", "errors.org", "daily-plan.org"],
  "fileColors": {
    "inbox-mobile.org": "#1d2bd8",
    "tasks.org": "#c2410c",
    "rec-tasks.org": "#0e7490",
    "errors.org": "#c81e1e"
  },
  "calendar": {
    "defaultView": "timeGridWeek",
    "mobileDefaultView": "timeGridDay",
    "firstDay": 1,
    "slotMinTime": "06:00",
    "slotMaxTime": "24:00",
    "scrollTime": "08:00",
    "bodyTimestamps": false,
    "noDragFiles": []
  },
  "filterPresets": [
    { "name": "All" },
    { "name": "Tasks", "files": ["tasks.org", "rec-tasks.org", "errors.org"] }
  ]
}
